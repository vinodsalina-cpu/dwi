{
  "name": "@platform/dwi-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "displayName": "Developer Workspace Intelligence",
  "description": "Local, consent-based project intelligence with project-aware Prompt Optimizer and required LLM provider configuration.",
  "publisher": "dwi-poc",
  "preview": true,
  "engines": {
    "vscode": "^1.125.0",
    "node": "24.18.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:dwi.open",
    "onCommand:dwi.openPromptOptimizer",
    "onView:dwi-view",
    "onView:dwi-prompt-optimizer-view"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dwi.open",
        "title": "Open Developer Work Intelligence",
        "category": "DWI"
      },
      {
        "command": "dwi.openPromptOptimizer",
        "title": "Open Prompt Optimizer",
        "category": "DWI"
      },
      {
        "command": "dwi.exportProjectSnapshot",
        "title": "Export Project Snapshot",
        "category": "DWI"
      },
      {
        "command": "dwi.exportBackstageComponent",
        "title": "Export Backstage Component",
        "category": "DWI"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dwi-sidebar",
          "title": "Developer Workspace Intelligence",
          "icon": "media/dwi.svg"
        },
        {
          "id": "dwi-prompt-optimizer-sidebar",
          "title": "Prompt Optimizer",
          "icon": "media/prompt-optimizer.svg"
        }
      ]
    },
    "views": {
      "dwi-sidebar": [
        {
          "type": "webview",
          "id": "dwi-view",
          "name": "Home"
        }
      ],
      "dwi-prompt-optimizer-sidebar": [
        {
          "type": "webview",
          "id": "dwi-prompt-optimizer-view",
          "name": "Prompt Optimizer"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/assemble.mjs",
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package:vsix": "pnpm build && node scripts/package-vsix.mjs"
  },
  "dependencies": {
    "@platform/domain-prompt-optimizer": "workspace:*",
    "@platform/domain-workspace": "workspace:*",
    "@platform/dwi-core": "workspace:*",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinodsalina-cpu/dwi.git"
  },
  "files": [
    "dist/**",
    "media/**",
    "README.md"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "DWI reads only bounded manifest/config evidence after explicit project consent and does not execute workspace code."
    }
  }
}
