{
  "extends": "../../../tsconfig.plugin.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "emitDeclarationOnly": false,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "**/*.spec.ts"]
}
