{
  "name": "@platform/dwi-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.18.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "platform": "./src/index.ts", "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
